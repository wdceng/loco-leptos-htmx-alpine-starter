# Production's secrets: copy to secrets.production.env in the repo root
# (git-ignored), which every deploy uploads as secrets.env for the unit to
# load (docs/production.md). Production has no defaults: every line below
# is required, and the app refuses to boot with one missing, empty or still
# "replace-me" (src/deploy_checks.rs). The deploy chain stops before
# building on the same.
#
# JWT_SECRET: production's own, shared with nothing. Base64, as Loco
# decodes it before signing. Make one with `openssl rand -base64 48`.
JWT_SECRET=replace-me

# Mail: host on 587 with STARTTLS (465 needs MAILER_PORT=465 and
# `tls: implicit` in the config); an app password, never the account's
# (Gmail: Security, 2-Step Verification, App passwords); the sender as
# "Name <address>", in double quotes, on the account's address or domain,
# or the provider rewrites or refuses it.
MAILER_HOST=replace-me
MAILER_USER=replace-me
MAILER_PASSWORD=replace-me
MAILER_FROM="App <replace-me>"
