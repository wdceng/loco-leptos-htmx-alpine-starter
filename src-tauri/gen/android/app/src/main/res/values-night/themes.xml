<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.app_native" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- The launch the start page's surface at night too: the start
             page is always light (values/themes.xml). -->
        <item name="android:windowBackground">@color/start_surface</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/start_surface</item>
    </style>
</resources>
