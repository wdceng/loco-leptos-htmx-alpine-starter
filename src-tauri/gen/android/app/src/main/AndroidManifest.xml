<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Nothing of the app's in a cloud backup or carried to another phone:
         its webview keeps the session's cookie. Android 12 and up ignore
         allowBackup for a transfer, so their rules too.
         Back through androidx's dispatcher on Android 13 and up: 13 to 15
         take it only when asked, 16 and up by default; without it Android
         15's Back reached onBackPressed alone and left the app. Android 7
         to 12 reach it through MainActivity's onBackPressed. -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app_native"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- A task of its own (`taskAffinity` empty): another app's activity
             cannot take the app's place in its task (task hijacking, OWASP
             MASTG). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
